{% comment %}Responsive YouTube embed. Usage: {% include youtube.liquid id="VIDEO_ID" title="Short description" %}{% endcomment %}
<div style="position: relative; padding-top: 56.25%; margin: 1rem 0 1.5rem">
  <iframe
    style="position: absolute; inset: 0; width: 100%; height: 100%; border: 0"
    src="https://www.youtube-nocookie.com/embed/{{ include.id }}"
    title="{{ include.title | default: 'YouTube video' }}"
    loading="lazy"
    allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
    allowfullscreen
  ></iframe>
</div>
